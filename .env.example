# Copy to `.env` and fill in. NEVER commit the filled-in file, and never paste
# keys into the notebook.

# Which OpenAI-compatible provider to call: groq | openrouter
LLM_PROVIDER=groq

# Model id. Leave blank to use the provider's default from pipeline.PROVIDERS.
# Groq examples:      openai/gpt-oss-120b | llama-3.3-70b-versatile | qwen/qwen3-32b
# OpenRouter free:    google/gemma-4-31b-it:free | nvidia/nemotron-3-super-120b-a12b:free
LLM_MODEL=

# https://console.groq.com/keys
GROQ_API_KEY=

# https://openrouter.ai/keys
OPENROUTER_API_KEY=
